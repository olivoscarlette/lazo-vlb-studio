# ==================================================
# LAZO — VLB STUDIO · PLANNING
# Variables de Entorno de Configuración y Producción
# ==================================================

# Puerto del servidor HTTP
PORT=3001

# Entorno de ejecución (development | production)
NODE_ENV=production

# Llave criptográfica secreta para firmar sesiones JWT (Cambia este valor en producción)
JWT_SECRET=vlb_studio_lazo_secret_key_change_in_production_2026

# ==================================================
# WHATSAPP BUSINESS — META CLOUD API
# ==================================================

# Token de acceso de usuario del sistema o permanente de Meta Cloud API (System User Access Token)
# Obtenido en: Meta Business Suite -> Usuarios del Sistema -> Generar Token con permisos whatsapp_business_messaging, whatsapp_business_management
WHATSAPP_API_TOKEN=EAAB...tu_token_aqui

# Identificador del número de teléfono (Phone Number ID)
# Obtenido en: Meta for Developers -> WhatsApp -> Configuración de la API -> Identificador de número de teléfono
WHATSAPP_PHONE_NUMBER_ID=1424004584122204

# Token personalizado para el Handshake de Verificación del Webhook (GET)
# Configura el mismo valor aquí y en el campo "Verificar token" del panel de Meta for Developers
WHATSAPP_VERIFY_TOKEN=lazo_vlb_webhook_token_2026

# Clave Secreta de la App (App Secret) para validación criptográfica X-Hub-Signature-256 en Webhooks POST
# Obtenido en: Meta for Developers -> Configuración de la app -> Información básica -> Clave secreta de la app
META_APP_SECRET=tu_meta_app_secret_aqui

# Versión de Meta Graph API (Recomendado: v21.0)
WHATSAPP_API_VERSION=v21.0

# Nombre de la plantilla de confirmación RSVP aprobada en el Administrador de WhatsApp
WHATSAPP_RSVP_TEMPLATE=rsvp_confirmacion_boda

# ==================================================
# CORREO ELECTRÓNICO — GMAIL / SMTP (RECUPERACIÓN DE CONTRASEÑA)
# ==================================================

# Tu cuenta de Gmail (ej. contacto@vivalabride.com o tu_correo@gmail.com)
GMAIL_USER=tu_cuenta@gmail.com

# Contraseña de aplicación de Google de 16 caracteres (Generada en: https://myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Nombre que aparecerá como remitente en la bandeja de entrada
EMAIL_FROM_NAME="Lazo — Viva la Bride"

# URL base de la aplicación para enlaces de recuperación (Producción)
APP_URL=https://www.lazostudio.mx

